#!/sbin/openrc-run
# OpenRC init script for Alpine Linux (and other OpenRC systems).
#
# Install:
#   adduser -S -D -H -h /opt/pixieveil -s /sbin/nologin pixieveil
#   git clone https://github.com/cstroie/PixieVeil.git /opt/pixieveil   # or rsync/symlink an existing checkout there
#   chown -R pixieveil:pixieveil /opt/pixieveil
#   su -s /bin/sh pixieveil -c 'python3 -m pip install --user -e /opt/pixieveil'
#   cp pixieveil.openrc /etc/init.d/pixieveil
#   chmod +x /etc/init.d/pixieveil
#   rc-update add pixieveil default
#   rc-service pixieveil start
#
# Optional overrides go in /etc/conf.d/pixieveil (auto-sourced by
# openrc-run), e.g. to point at a different checkout or Python:
#   pixieveil_home="/opt/pixieveil"
#   pixieveil_python="/opt/pixieveil/.venv/bin/python3"

name="pixieveil"
description="PixieVeil DICOM anonymization server"

: "${pixieveil_user:=pixieveil}"
: "${pixieveil_group:=pixieveil}"
: "${pixieveil_home:=/opt/pixieveil}"
: "${pixieveil_python:=${pixieveil_home}/.venv/bin/python3}"

# Fall back to system python3 if no dedicated venv was set up.
if [ ! -x "${pixieveil_python}" ]; then
	pixieveil_python="/usr/bin/python3"
fi

# supervise-daemon (not start-stop-daemon --background) because
# pixieveil.py runs in the foreground and doesn't fork itself — same
# reasoning as Type=simple in the systemd unit. It also gives us respawn-
# on-crash for free, mirroring Restart=on-failure there.
supervisor="supervise-daemon"
command="${pixieveil_python}"
command_args="${pixieveil_home}/pixieveil.py --pidfile /run/${RC_SVCNAME}.pid"
command_user="${pixieveil_user}:${pixieveil_group}"
directory="${pixieveil_home}"
pidfile="/run/${RC_SVCNAME}.pid"

respawn_delay=5
respawn_max=0

# Secrets (remote DICOM/HTTP export credentials) belong in
# config/settings.yaml (chmod 600, not tracked by git) in pixieveil_home,
# not in this init script or /etc/conf.d/pixieveil.

# supervise-daemon logs the supervised process's stdout/stderr here. Kept
# under the checkout's own data/log/ dir (not /var/log) so everything
# PixieVeil writes stays in one place. Application logs still go to the
# path configured under logging.file in config/settings.yaml.
output_log="${pixieveil_home}/data/log/pixieveil.out"
error_log="${pixieveil_home}/data/log/pixieveil.out"

# SIGTERM triggers pixieveil.py's own graceful-shutdown handler (the
# SIGINT/SIGTERM asyncio signal handlers in pixieveil.cli.main()); give
# in-flight exports / sidecar writes a bit of time before escalating.
retry="TERM/20/KILL/5"

depend() {
	need net
	use dns
}
